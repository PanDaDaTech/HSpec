// hspec.rc
#include "resource.h"
#include <winres.h>

IDI_MAIN_ICON ICON "winres/hspec.ico"

IDR_FONT RCDATA "winres/MiSans-Medium.ttf"

1 24 "hspec.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VER_FILEVERSION
 PRODUCTVERSION VER_PRODUCTVERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "PanDaTech"
            VALUE "FileDescription", "HSpec - Desktop Hardware Info"
            VALUE "FileVersion", VER_FILEVERSION_STR
            VALUE "InternalName", "HSpec"
            VALUE "LegalCopyright", "Copyright (C) 2026 PanDaTech"
            VALUE "OriginalFilename", "HSpec.exe"
            VALUE "ProductName", "HSpec"
            VALUE "ProductVersion", VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
